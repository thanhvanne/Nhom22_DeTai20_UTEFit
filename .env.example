# Copy VALUES into IntelliJ Run > Edit Configurations > Environment variables.
# Spring Boot does not automatically load .env files.
DB_USERNAME=YOUR_LOCAL_SQL_LOGIN
DB_PASSWORD=YOUR_LOCAL_SQL_PASSWORD
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UTEFitDB;encrypt=true;trustServerCertificate=true
JWT_SECRET_BASE64=GENERATE_RANDOM_BASE64_32_BYTES_LOCALLY
JWT_COOKIE_SECURE=false
SEPAY_ENABLED=false
SEPAY_LIVE_ENABLED=false
SEPAY_LIVE_ACCEPT_NEW_PAYMENTS=false
SEPAY_MANUAL_RECONCILIATION_ENABLED=false
SEPAY_LIVE_API_LOOKUP_ENABLED=false
VNPAY_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@utefit.test
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
