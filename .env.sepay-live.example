SPRING_PROFILES_ACTIVE=sepay,sepay-live
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:sqlserver://YOUR_SQL_HOST:1433;databaseName=YOUR_LIVE_DATABASE;encrypt=true;trustServerCertificate=false
SPRING_DATASOURCE_USERNAME=YOUR_RUNTIME_USER
SPRING_DATASOURCE_PASSWORD=YOUR_RUNTIME_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_SQL_INIT_MODE=never
SEPAY_ENABLED=false
SEPAY_ENVIRONMENT=live
SEPAY_LIVE_ENABLED=false
SEPAY_LIVE_ACCEPT_NEW_PAYMENTS=false
SEPAY_LIVE_APPROVAL=
SEPAY_LIVE_DATABASE_NAME=YOUR_LIVE_DATABASE
SEPAY_LIVE_DEPLOYMENT_ID=YOUR_DEPLOYMENT_IDENTIFIER
SEPAY_LIVE_PUBLIC_URL=https://your-live-host.example
SEPAY_LIVE_BANK_CODE=YOUR_BANK
SEPAY_LIVE_GATEWAY=YOUR_GATEWAY
SEPAY_LIVE_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
SEPAY_LIVE_VA_NUMBER=
SEPAY_LIVE_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
SEPAY_LIVE_WEBHOOK_SECRET=YOUR_DISTINCT_LIVE_HMAC_SECRET
SEPAY_WEBHOOK_AUTH=hmac
SEPAY_PAYMENT_PREFIX=UTE
SEPAY_PAYMENT_MINUTES=15
SEPAY_COOKIE_SECURE=true
SEPAY_TEST_QR_PREVIEW=false
SEPAY_LIVE_API_LOOKUP_ENABLED=false
SEPAY_LIVE_API_TOKEN=YOUR_READ_ONLY_API_TOKEN
SEPAY_LIVE_BANK_ACCOUNT_ID=YOUR_BANK_ACCOUNT_UUID
